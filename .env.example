# Copy to .env.local (git-ignored). All values are optional for local development.

# Production: URL of your deployed Cloudflare Worker (no trailing slash).
# Leave unset in development — Vite proxies /api to `wrangler dev`.
# VITE_SERVER_URL=https://who-said-that.your-subdomain.workers.dev

# Base path the frontend is served from. GitHub Pages project sites use "/<repo>/".
# VITE_BASE=/who-said-that/

# Public URL used in the join QR code (handy when you open the host page via
# localhost but phones need your LAN address, e.g. http://192.168.1.20:5173).
# VITE_PUBLIC_URL=

# Dev only: where the Vite proxy forwards /api (default http://127.0.0.1:8787).
# DEV_WORKER_URL=http://127.0.0.1:8787
