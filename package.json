{
  "name": "who-said-that",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Who Said That? — a multiplayer family party game (React + Cloudflare Durable Objects)",
  "scripts": {
    "dev": "concurrently -k -n worker,web -c magenta,cyan \"npm:dev:worker\" \"npm:dev:web\"",
    "dev:worker": "wrangler dev --config worker/wrangler.toml --port 8787",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run typecheck && vite build --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "preview": "vite preview --config web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p worker/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate:prompts": "vitest run tests/unit/prompts.test.ts",
    "deploy:worker": "wrangler deploy --config worker/wrangler.toml"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261117.1",
    "@playwright/test": "^1.63.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.7",
    "postcss": "^8.5.33",
    "tailwindcss": "3.4",
    "typescript": "5.9",
    "vite": "^6.4.6",
    "vitest": "^3.2.7",
    "wrangler": "^4.164.0"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "canvas-confetti": "^1.9.4",
    "framer-motion": "^11.18.2",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76",
    "zustand": "^5.1.0"
  }
}
